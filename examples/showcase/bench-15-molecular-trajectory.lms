# B15 / P.7: molecular trajectory, orbital path, projected labels, live energy plot and frame cache.
mkdir("build"); program=_lmcode_ cli="lmvideo";
video.size(1280,720); video.fps(30); video.frames(120); video.crf(20); video.output("build/bench-15-molecular-trajectory.mp4"); video.begin();
let scene=scene3d().background("#09111f").ambient(0.18); scene.camera(camera3d().look_at(0.0,1.6,5.0,0.0,0.4,0.0).perspective(40.0,0.1,20.0)); let oxygen=scene.add(mesh_sphere(0.52,24,32),"#d95356"); let hydrogen=mesh_sphere(0.32,16,24); scene.add(hydrogen,"#c9e2f1").position(-0.95,0.65,0.0); scene.add(hydrogen,"#c9e2f1").position(0.95,0.65,0.0); scene.add(mesh_cylinder(0.10,1.05,20),"#778d9d").position(-0.475,0.325,0.0); scene.add(mesh_cylinder(0.10,1.05,20),"#778d9d").position(0.475,0.325,0.0); scene.directional_light(1.0,3.0,4.0,"#ffffff",1.0);
let cache=timeline_create(820,560); let destination=image_create(820,560,"#00000000"); let plot=canvas.plot(860.0,90.0,360.0,500.0).title("Live potential energy").xlabel("time (s)").ylabel("E").x_range(0.0,4.0).y_range(-1.2,1.2).background("#ffffff"); let trace=plot.series("E","line","#e76f51");
for(frame in range(0,video.count())) { video.frame(); let t=video.time(); let angle=6.283185307*t/4.0; oxygen.position(0.22*sin(angle),0.4+0.18*cos(angle),0.0); let rendered=scene.render_image(820,560,destination); cache.add(rendered,video.index()); canvas.clear("#09111f"); canvas.image(rendered,20.0,80.0); canvas.line(300.0,260.0,350.0,220.0,paint().color("#6fa8d6").stroke().stroke_width(2.0)); canvas.line(350.0,220.0,420.0,210.0,paint().color("#6fa8d6").stroke().stroke_width(2.0)); canvas.line(420.0,210.0,490.0,220.0,paint().color("#6fa8d6").stroke().stroke_width(2.0)); canvas.line(490.0,220.0,540.0,260.0,paint().color("#6fa8d6").stroke().stroke_width(2.0)); canvas.text("O",405.0,335.0,font(22.0),paint().color("#ffffff")); canvas.text("H",300.0,365.0,font(18.0),paint().color("#d9f1ff")); canvas.text("H",500.0,365.0,font(18.0),paint().color("#d9f1ff")); trace.add(t,0.8*cos(angle)-0.2); plot.draw(); if(video.index()==video.count()-1){canvas.snapshot().resize(900,560).save("build/bench-15-molecular-trajectory.png");} }
image_assert_true(cache.size()==120); video.end(); out.print("B15: molecule trajectory, projected labels, live energy plot, frame cache 120");
end _lmcode_
savedsl(program,"build/bench-15-molecular-trajectory.dslb"); r=system(concat(dsl_cli(program),["--dsl","build/bench-15-molecular-trajectory.dslb"]),600000); assert(r.code==0,r.stdout+r.stderr);
