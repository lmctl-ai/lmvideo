# B05: analytic UV relief under a moving/grazing key; compare flat and height-normal paths.
mkdir("build");program=_lmcode_ cli="lmvideo";
let height=image_pattern(256,256,"0.5+0.16*sin(x*26)*cos(y*23)+0.08*cos(x*51+y*17)","0.5+0.16*sin(x*26)*cos(y*23)+0.08*cos(x*51+y*17)","0.5+0.16*sin(x*26)*cos(y*23)+0.08*cos(x*51+y*17)","1");let quad=mesh_triangles("-1.7,-1.3,0,1.7,-1.3,0,1.7,1.3,0,-1.7,1.3,0","0,1,2,0,2,3").uvs("0,1,1,1,1,0,0,0");let scene=scene3d().background("#eaf0f6").ambient(0.025);scene.camera(camera3d().look_at(0.0,0.0,4.8,0.0,0.0,0.0).perspective(38.0,0.1,20.0));let mat=material("#bd7a3f",0.25,0.48);let node=scene.add(quad,mat);scene.directional_light(3.0,0.35,1.0,"#fff4d6",3.8);let flat=scene.render_image(900,560,2);node.material(mat.copy().height(height,0.24,true));let relief=scene.render_image(900,560,2);image_assert_true(flat.rgba()!=relief.rgba()&&relief.width()==900&&relief.height()==560&&relief.stddev(0)>0.04);relief.save("build/bench-05-tangent-relief-medallion.png");
end _lmcode_
savedsl(program,"build/bench-05-tangent-relief-medallion.dslb");r=system(concat(dsl_cli(program),["--dsl","build/bench-05-tangent-relief-medallion.dslb"]),600000);assert(r.code==0,r.stdout+r.stderr);
