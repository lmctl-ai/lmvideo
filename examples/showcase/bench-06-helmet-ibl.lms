# B06: original helmet analogue exported to GLB and imported with all authored PBR maps.
mkdir("build"); program=_lmcode_ cli="lmvideo";
let studio=image_pattern(128,64,"0.12+0.75*exp(-140*(x-0.28)^2-30*(y-0.35)^2)","0.16+0.70*exp(-140*(x-0.28)^2-30*(y-0.35)^2)","0.22+0.62*exp(-140*(x-0.28)^2-30*(y-0.35)^2)","1");
let albedo=texture_from_image(image_pattern(64,64,"0.18+0.10*sin(x/5)","0.23+0.08*cos(y/7)","0.29+0.06*sin((x+y)/9)","1"),"srgb");
let orm=texture_from_image(image_pattern(64,64,"1","0.34+0.25*x/64","0.72+0.18*y/64","1"),"linear");
let normal=texture_from_image(image_pattern(64,64,"0.5+0.06*sin(x/3)","0.5+0.06*cos(y/4)","1","1"),"linear");
let emissive=texture_from_image(image_pattern(64,64,"0.0","0.02+0.03*sin(x/8)","0.05+0.08*cos(y/9)","1"),"linear");
let helmet=mesh_sphere(1.5,32,48); let mat=material("#9aaac0",0.72,0.28).albedo(albedo).orm(orm).normal(normal).emissive("#163b70",0.16);
let source=scene3d().background("#101824").ambient(0.08); source.camera(camera3d().look_at(0.0,0.0,6.0,0.0,0.0,0.0).perspective(38.0,0.1,50.0)); source.add(helmet,mat); source.export_gltf("build/original-helmet-analogue.glb",true);
let scene=scene3d().background("#101824").ambient(0.08).environment(environment_image(studio),1.4,18.0,true); scene.camera(camera3d().look_at(0.0,0.0,6.0,0.0,0.0,0.0).perspective(38.0,0.1,50.0)); scene.import_gltf("build/original-helmet-analogue.glb",1.0); scene.directional_light(-3.0,4.0,5.0,"#fff0d5",2.1).directional_light(3.0,1.0,-2.0,"#75a9e5",0.7); let image=scene.render_image(900,560,2); image.save("build/bench-06-helmet-ibl.png"); image_assert_true(image.stddev(0)>0.03); out.print("original GLB helmet analogue; albedo ORM normal emissive; generated studio IBL");
end _lmcode_
savedsl(program,"build/bench-06-helmet-ibl.dslb"); let r=system(concat(dsl_cli(program),["--dsl","build/bench-06-helmet-ibl.dslb"]),600000); assert(r.code==0,r.stdout+r.stderr);
