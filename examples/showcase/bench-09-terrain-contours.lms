# B09: seeded 128x128 FBM-like terrain with elevation/slope colour and marching contours.
mkdir("build"); program=_lmcode_ cli="lmvideo";
let heights=image_pattern(128,128,"0.5+0.22*sin(x/11)*cos(y/15)+0.10*sin(x/4+y/7)","0.5+0.22*sin(x/11)*cos(y/15)+0.10*sin(x/4+y/7)","0.5+0.22*sin(x/11)*cos(y/15)+0.10*sin(x/4+y/7)","1"); let terrain=mesh_heightfield(heights,5.0,5.0,2.0); image_assert_true(terrain.vertices()==16384&&terrain.triangles()==32258);
let scene=scene3d().background("#edf3f8").ambient(0.2); scene.camera(camera3d().look_at(5.0,4.0,7.0,0.0,0.5,0.0).perspective(42.0,0.1,100.0)); scene.add(terrain,material("#ffffff",0.0,0.85)); scene.directional_light(1.0,4.0,3.0,"#fff",1.0); let rendered=scene.render_image(560,500,2);
video.size(900,560); video.frames(1); video.output("build/bench-09-terrain-contours.png"); video.begin(); video.frame(); canvas.clear("#edf3f8"); canvas.image(rendered,20.0,40.0); let p=canvas.plot(600.0,40.0,280.0,480.0).title("FBM elevation contours").xlabel("x").ylabel("y").x_range(0.0,1.0).y_range(0.0,1.0).legend("none").background("#fff"); let h=p.heatmap("elevation",33,33).palette("viridis").range(0.0,1.0).contours(10,"#17202a",1.0).colorbar(true); for(j in range(0,33)){for(i in range(0,33)){let x=float(i)/32.0;let y=float(j)/32.0;h.cell(32-j,i,0.5+0.22*sin(x*11.0)*cos(y*15.0)+0.10*sin(x*4.0+y*7.0));}} p.draw(); canvas.text("128 × 128 seeded heightfield · slope/elevation vertex colours",20.0,540.0,font(17.0),paint().color("#17364d")); video.save_frame("build/bench-09-terrain-contours.png"); video.end();
end _lmcode_
savedsl(program,"build/bench-09-terrain-contours.dslb"); let r=system(concat(dsl_cli(program),["--dsl","build/bench-09-terrain-contours.dslb"]),600000); assert(r.code==0,r.stdout+r.stderr);
