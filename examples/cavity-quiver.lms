# Analytic lid-driven cavity field, using the same streamfunction and 9x9 arrows as lmplot.
mkdir("images");standalone=ARGV.len()==0;dslout=ARGV.len()>0?ARGV[0]:"build/cavity-quiver.dslb";let mp4=ARGV.len()>1?ARGV[1]:"images/cavity-quiver.mp4";let png=ARGV.len()>2?ARGV[2]:"images/cavity-quiver.png";
let speedmax=0.0;for(j in range(1,40)){for(i in range(1,40)){let x=num(i)/40.0;let y=num(j)/40.0;let u=x*x*(1.0-x)*(1.0-x)*(2.0*y-3.0*y*y);let v=-2.0*x*(1.0-x)*(1.0-2.0*x)*y*y*(1.0-y);let speed=sqrt(u*u+v*v);if(speed>speedmax){speedmax=speed;}}}
program = _lmcode_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.26";
video.size(960,540);video.frames(1);video.output(${mp4});video.begin();video.frame();canvas.clear("#f5f7fa");fn psi(x: float, y: float) -> float { return x*x*(1.0-x)*(1.0-x)*y*y*(1.0-y); }fn ux(x: float, y: float) -> float { return x*x*(1.0-x)*(1.0-x)*(2.0*y-3.0*y*y); }fn vy(x: float, y: float) -> float { return -2.0*x*(1.0-x)*(1.0-2.0*x)*y*y*(1.0-y); }let p=canvas.plot(215.0,20.0,530.0,500.0).title("Cavity-like streamfunction and velocity vectors").xlabel("x").ylabel("y").x_range(0.0,1.0).y_range(0.0,1.0).legend("none").background("#ffffff");let h=p.heatmap("streamfunction",41,41).palette("viridis").range(0.0,0.015).colorbar(false);for(j in range(0,41)){for(i in range(0,41)){let x=float(i)/40.0;let y=float(j)/40.0;h.cell(40-j,i,psi(x,y));}}let field=p.quiver("velocity").color("#202b3c");for(j in range(0,9)){for(i in range(0,9)){let x=0.1+float(i)*0.1;let y=0.1+float(j)*0.1;field.add(x,y,ux(x,y)*0.06/${round(speedmax*1000000.0)/1000000.0},vy(x,y)*0.06/${round(speedmax*1000000.0)/1000000.0});}}p.draw();video.save_frame(${png});video.end();
end _lmcode_
mkdir(dirname(dslout));savedsl(program,dslout);if(standalone){r=system(concat(dsl_cli(program),["--lmcode",dslout]),600000);if(r.code!=0){println(r.stderr+r.stdout);}assert(r.code==0);}
