# G.13: an original solid-red JPEG image in a glTF data URI; no downloaded asset.
# Vertex/UV data is little-endian and the JPEG was generated by lmvideo's encoder.
mkdir("build");
write_file("build/jpeg-material.gltf", "{\"asset\":{\"version\":\"2.0\",\"generator\":\"lmvideo first-party JPEG material witness\"},\"buffers\":[{\"uri\":\"data:application/octet-stream;base64,AAAAAAAAAAAAAAAAAACAPwAAAAAAAAAAAAAAAAAAgD8AAAAAAAABAAIAAAAAAAAAAAAAAAAAgD8AAAAAAAAAAAAAgD8=\",\"byteLength\":68}],\"bufferViews\":[{\"buffer\":0,\"byteLength\":36,\"target\":34962},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":6,\"target\":34963},{\"buffer\":0,\"byteOffset\":44,\"byteLength\":24,\"target\":34962}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\",\"min\":[0,0,0],\"max\":[1,1,0]},{\"bufferView\":1,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"},{\"bufferView\":2,\"componentType\":5126,\"count\":3,\"type\":\"VEC2\"}],\"images\":[{\"uri\":\"data:image/jpeg;base64,\",\"mimeType\":\"image/jpeg\"}],\"textures\":[{\"source\":0}],\"materials\":[{\"pbrMetallicRoughness\":{\"baseColorTexture\":{\"index\":0},\"metallicFactor\":0,\"roughnessFactor\":1}}],\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0,\"TEXCOORD_0\":2},\"indices\":1,\"material\":0}]}],\"nodes\":[{\"mesh\":0}],\"scenes\":[{\"nodes\":[0]}],\"scene\":0}");
program=_lmcode_ cli="lmvideo";
let camera=camera3d().look_at(0.0,0.0,4.0,0.0,0.0,0.0).perspective(38.0,0.1,20.0);
let scene=scene3d().threads(4).background("#15202b").ambient(1.0);
scene.import_gltf("build/jpeg-material.gltf",1.0).position(-0.5,-0.5,0.0);
scene.camera(camera);
let first=scene.render_image(900,560,2);
image_assert_true(first.stddev(0)>0.03);
scene.export_gltf("build/jpeg-material.glb",true);
let warm=scene3d().threads(4);
warm.import_gltf("build/jpeg-material.glb",1.0);
warm.camera(camera).background("#15202b").ambient(1.0);
let second=warm.render_image(900,560,2);
image_assert_true(first.rgba()==second.rgba());
first.save("build/jpeg-material-roundtrip.png");
end _lmcode_
savedsl(program,"build/jpeg-material-roundtrip.dslb");
r=system(concat(dsl_cli(program),["--dsl","build/jpeg-material-roundtrip.dslb"]),600000);
assert(r.code==0,r.stdout+r.stderr);println(r.stdout);
