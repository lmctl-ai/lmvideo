# lmvideo video example (EXPERIMENTAL _dsl_): the DSL owns both the frame loop and
# the per-frame drawing loop; the host owns the surface and encoder.
# Run from the repo root: $LMSCRIPT_BIN examples/video.lms [OUT.dslb] [OUT.mp4] [FRAMES] [FPS]
#   (no arguments: also runs it with the released lmvideo host; with arguments it only compiles, then run: lmvideo --dsl OUT.dslb)
standalone = ARGV.len() == 0;
dslout = ARGV.len() > 0 ? ARGV[0] : "build/video.dslb";
mp4 = ARGV.len() > 1 ? ARGV[1] : "images/video.mp4";
frames = ARGV.len() > 2 ? num(ARGV[2]) : 60;
fps = ARGV.len() > 3 ? num(ARGV[3]) : 30;
mkdir("images");
program = _lmcode_ cli="lmvideo" install="github:lmctl-ai/lmvideo@latest";
video.size(320, 180);
video.fps(${fps});
video.frames(${frames});
video.output(${mp4});
video.begin();
for (f in range(0, video.count())) {
  video.frame();
  let w = float(video.width());
  let h = float(video.height());
  let t = video.t();
  let e = ease(t);
  canvas.clear(mix("#0b132b", "#5bc0be", e));
  # a ball sliding across with a sine bounce, growing a little
  let x = 0.0;
  let y = 0.0;
  for (attribute in range(0, 2)) {
    if (attribute == 0) { x = lerp(40.0, w - 40.0, e); }
    else { y = h * 0.6 - abs(sin(t * 6.2831853 * 2.0)) * h * 0.35; }
  }
  canvas.circle(x, y, 18.0 + 10.0 * t, paint().color(mix("#ffd166", "#ef476f", t)));
  # a progress bar and a frame counter
  canvas.rect(20.0, h - 24.0, (w - 40.0) * t, 8.0, paint().color("#ffffff"));
  canvas.text("frame " + str(video.index() + 1) + "/" + str(video.count()), 20.0, 30.0, font(18.0), paint().color("#ffffff"));
}
video.end();
end _lmcode_
mkdir(dirname(dslout));
savedsl(program, dslout);
# No arguments: run the compiled chunk with the released host (lmctl autorun). With arguments: compile only.
if (standalone) {
  r = system(concat(dsl_cli(program), ["--dsl", dslout]), 600000);
  if (r.code != 0) { println(r.stderr + r.stdout); }
  assert(r.code == 0);
}
println(f"wrote {dslout} (video {mp4}, {frames} frames at {fps} fps)");
