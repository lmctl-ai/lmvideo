# G.2 closed lathe witness: annular cylinder, hollow bowl and axis-capped goblet.
mkdir("build"); program=_lmcode_ cli="lmvideo";
let annular=mesh_lathe_closed("1,0,0,2,0,0,2,1,0,1,1,0",32);
let bowl=mesh_lathe_closed("0,0,0,1,0,0,1.2,0.3,0,1.1,1.0,0,0.9,1.3,0,0.6,1.3,0,0.7,1.1,0,0.75,0.4,0,0,0.4,0",40);
let goblet=mesh_lathe_closed("0,0,0,0.65,0,0,0.7,0.06,0,0.65,0.12,0,0.12,0.16,0,0.09,0.2,0,0.09,0.7,0,0.16,0.77,0,0.45,0.9,0,0.68,1.1,0,0.78,1.4,0,0.8,1.65,0,0.74,1.65,0,0.72,1.4,0,0.62,1.15,0,0.4,0.98,0,0.15,0.88,0,0,0.85,0",48);
image_assert_true(annular.triangles()>100&&bowl.triangles()>100&&goblet.triangles()>100);
let scene=scene3d().threads(4).background("#edf1f5").ambient(0.16);
scene.camera(camera3d().look_at(4.4,2.8,6.8,0.0,0.8,0.0).perspective(40.0,0.1,30.0));
scene.add(annular,material("#9aa7b5",0.15,0.35)).position(-2.5,0.0,0.0).scale(0.45,0.6,0.45);
scene.add(bowl,material("#b96945",0.35,0.28)).position(0.0,0.0,0.0);
scene.add(goblet,material("#4f8da8",0.5,0.22)).position(2.3,0.0,0.0);
scene.directional_light(-2.0,4.0,3.0,"#fff4de",1.8).directional_light(3.0,2.0,-1.0,"#a9c9ee",0.6);
let image=scene.render_image(900,560,2);image_assert_true(image.stddev(0)>0.03);image.save("build/closed-lathe-goblets.png");
out.print("closed lathe annular, hollow bowl and axis-capped goblet; reversed contours normalize outward volume");
end _lmcode_
savedsl(program,"build/closed-lathe-goblets.dslb");r=system(concat(dsl_cli(program),["--lmcode","build/closed-lathe-goblets.dslb"]),600000);assert(r.code==0,r.stderr+r.stdout);println(r.stdout);
