# Record a single chart and replay it as raster, SVG, PDF, and serialized Skia picture.
standalone=ARGV.len()==0;dslout=ARGV.len()>0?ARGV[0]:"build/vector-outputs.dslb";let mp4=ARGV.len()>1?ARGV[1]:"images/vector-outputs.mp4";let png=ARGV.len()>2?ARGV[2]:"images/vector-outputs.png";let svg_path=ARGV.len()>3?ARGV[3]:"images/vector-outputs.svg";let png2=ARGV.len()>4?ARGV[4]:"images/vector-outputs-2x.png";let png3=ARGV.len()>5?ARGV[5]:"images/vector-outputs-3x.png";let pdf_path=ARGV.len()>6?ARGV[6]:"images/vector-outputs.pdf";let skp_path=ARGV.len()>7?ARGV[7]:"images/vector-outputs.skp";let report_path=ARGV.len()>8?ARGV[8]:"images/vector-report.pdf";let roundtrip_path=ARGV.len()>9?ARGV[9]:"images/vector-roundtrip.png";let surface_svg=ARGV.len()>10?ARGV[10]:"images/surface-svg-export.svg";let surface_pdf=ARGV.len()>11?ARGV[11]:"images/surface-pdf-export.pdf";
mkdir("images");
program = _dsl_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.29";
let recording=document(960,540);let c=recording.canvas();c.clear("#f5f7fa");let plot=c.plot(35.0,25.0,890.0,480.0).title("One Skia chart · four document outputs").xlabel("month").ylabel("revenue ($M)").x_range(0.0,11.0).y_range(0.0,120.0).background("#ffffff");let actual=plot.series("actual","line","#2878b5").width(3.0).marker("circle");let forecast=plot.series("forecast band","area","#d05a38");for(i in range(0,12)){let x=float(i);let y=58.0+3.6*x+12.0*sin(float(i)*0.65);actual.add(x,y);forecast.add(x,y-7.0+2.0*cos(float(i)*0.4));forecast.add_band(x,y-7.0,y+7.0);}plot.draw();let pic=recording.finish();
pic.png(${png},1);pic.png(${png2},2);pic.png(${png3},3);pic.svg(${svg_path});pic.pdf(${pdf_path});pic.skp(${skp_path});
let restored=picture_file(${skp_path});if(restored.width()!=960||restored.height()!=540){out.fail("SKP dimensions did not round-trip");}let page_recording=document(960,540);let page_canvas=page_recording.canvas();page_canvas.clear("#f5f7fa");let dashboard=page_canvas.panel(16.0,16.0,928.0,508.0).manager("grid").columns(2).gap(12.0).padding(10.0,10.0,10.0,10.0).background("#ffffff");let left=dashboard.add_plot().grid(0,0,1,1).fill("both").plot().title("Orders by month").xlabel("month").ylabel("orders").background("#ffffff");let orders=left.series("orders","line","#2878b5").marker("circle");let right=dashboard.add_plot().grid(0,1,1,1).fill("both").plot().title("Revenue by month").xlabel("month").ylabel("revenue ($M)").background("#ffffff");let sales=right.series("revenue","bar","#38a169");for(i in range(0,8)){let x=float(i);orders.add(x,25.0+3.0*x+8.0*sin(x*0.6));sales.add(x,40.0+6.0*x+12.0*sin(x*0.5));}dashboard.draw();let panel_page=page_recording.finish();let report=pdf_document(960.0,540.0).add_page(pic).add_page(panel_page);if(report.pages()!=2){out.fail("PDF page count did not reach two");}report.write(${report_path});
# Reload the emitted SVG with lmvideo's normal SVG parser and rasterize it through Surface.
let roundtrip=surface(960,540);roundtrip.canvas().clear("#ffffff");roundtrip.canvas().svg(svg_file(${svg_path}),0.0,0.0,960.0,540.0);roundtrip.png(${roundtrip_path});roundtrip.svg(${surface_svg});roundtrip.pdf(${surface_pdf});
video.size(960,540);video.frames(1);video.output(${mp4});video.begin();video.frame();canvas.clear("#f5f7fa");canvas.image(roundtrip.image(),0.0,0.0);video.save_frame(${png});video.end();
end _dsl_
mkdir(dirname(dslout));savedsl(program,dslout);if(standalone){r=system(concat(dsl_cli(program),["--dsl",dslout]),600000);if(r.code!=0){println(r.stderr+r.stdout);}assert(r.code==0);}
