# Same deterministic 400-case imbalanced sample and score transform as the lmplot port.
let seed=77003;let n=400;let labels=[];let scores=[];
for(i in range(0,n)){let g=-6.0;for(k in range(0,12)){seed=(seed*16807)%2147483647;g=g+num(seed)/2147483647.0;}seed=(seed*16807)%2147483647;let positive=num(seed)/2147483647.0<0.15?1:0;labels=push(labels,positive);scores=push(scores,1.0/(1.0+pow(2.718281828459045,-(1.6*num(positive)+g))));}
let pos=0;for(i in range(0,n)){pos=pos+labels[i];}let prevalence=num(pos)/num(n);let thresholds=sort(scores);let points=[];let ap=0.0;let previous=0.0;
for(k in range(0,n)){let t=thresholds[n-1-k];let tp=0;let fp=0;for(i in range(0,n)){if(scores[i]>=t){if(labels[i]==1){tp=tp+1;}else{fp=fp+1;}}}let recall=num(tp)/num(pos);let precision=num(tp)/num(tp+fp);if(tp+fp==0){precision=1.0;}ap=ap+(recall-previous)*precision;previous=recall;points=push(points,recall);points=push(points,precision);}
mkdir("images");standalone=ARGV.len()==0;dslout=ARGV.len()>0?ARGV[0]:"build/pr-average-precision.dslb";let mp4=ARGV.len()>1?ARGV[1]:"images/pr-average-precision.mp4";let png=ARGV.len()>2?ARGV[2]:"images/pr-average-precision.png";
program = _lmcode_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.26";
video.size(960,540);video.frames(1);video.output(${mp4});video.begin();video.frame();canvas.clear("#f5f7fa");let p=canvas.plot(30.0,20.0,900.0,500.0).title("Precision–recall · AP "+${str(round(ap*1000.0)/1000.0)}).xlabel("recall").ylabel("precision").x_range(0.0,1.0).y_range(0.0,1.0).background("#ffffff");let base=p.series("prevalence","line","#94a3b8").dash("dashed");base.add(0.0,${prevalence}).add(1.0,${prevalence});let pr=p.series("classifier","line","#d05a38").width(3.0);let previous_recall=0.0;for(k in range(0,101)){let threshold=1.0-float(k)/100.0;let local_seed=77003;let local_pos=0;let tp=0;let fp=0;for(i in range(0,400)){let g=-6.0;for(j in range(0,12)){local_seed=(local_seed*16807)%2147483647;g=g+float(local_seed)/2147483647.0;}local_seed=(local_seed*16807)%2147483647;let positive=float(local_seed)/2147483647.0<0.15;let shift=0.0;if(positive){shift=1.6;local_pos=local_pos+1;}let score=1.0/(1.0+pow(2.718281828459045,-(shift+g)));if(score>=threshold){if(positive){tp=tp+1;}else{fp=fp+1;}}}let recall=float(tp)/float(local_pos);let precision=1.0;if(tp+fp>0){precision=float(tp)/float(tp+fp);}pr.add(recall,precision);previous_recall=recall;}p.draw();video.save_frame(${png});video.end();
end _lmcode_
mkdir(dirname(dslout));savedsl(program,dslout);if(standalone){r=system(concat(dsl_cli(program),["--lmcode",dslout]),600000);if(r.code!=0){println(r.stderr+r.stdout);}assert(r.code==0);}
