# G.2: bounded sampled lathe profiles with finite radius/height/zero-Z inputs.
mkdir("build");
program = _lmcode_ cli="lmvideo";
let scene=scene3d().threads(4).background("#edf3f8").ambient(0.15);
scene.camera(camera3d().look_at(5.0,3.5,8.0,0.0,0.8,0.0).perspective(38.0,0.1,50.0));
let vase=mesh_lathe("0,0,0,0.7,0.04,0,1.0,0.5,0,0.6,1.3,0,0.5,1.8,0,0.65,2.0,0",40);
image_assert_true(vase.vertices()==246 && vase.triangles()>300);
image_assert_close(vase.bound(3),1.0,0.000001);
image_assert_close(vase.bound(4),2.0,0.000001);
scene.add(vase,material("#359b9a",0.1,0.32)).position(-1.35,0.0,0.0);
let stepped=mesh_lathe("0.4,0,0,0.9,0.5,0,0.9,1.0,0,0.45,1.5,0,0.3,2.0,0",32);
scene.add(stepped,material("#de7656",0.3,0.48)).position(1.25,0.0,0.0);
scene.directional_light(1.0,3.0,4.0,"#ffffff",1.5);
let image=scene.render_image(900,560,2);
image_assert_true(image.stddev(0)>0.02);
image.save("build/lathe-profile-oracle.png");
end _lmcode_
savedsl(program,"build/lathe-profile-oracle.dslb");
r=system(concat(dsl_cli(program),["--lmcode","build/lathe-profile-oracle.dslb"]),600000);
assert(r.code==0,r.stdout+r.stderr);println(r.stdout);
