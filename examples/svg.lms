# lmvideo SVG example (EXPERIMENTAL _dsl_): an SVG file is the general drawing format; the chunk places it on a canvas it also
# draws on, scaled to a target rectangle. Run from the repo root:
#   $LMSCRIPT_BIN examples/svg.lms [OUT.dslb] [OUT.png] [SVG_FILE]   (no arguments: compile and run with the released host; with arguments: compile only, then lmvideo --dsl OUT.dslb)
standalone = ARGV.len() == 0;
dslout = ARGV.len() > 0 ? ARGV[0] : "build/svg.dslb";
png = ARGV.len() > 1 ? ARGV[1] : "images/svg.png";
svgfile = ARGV.len() > 2 ? ARGV[2] : "images/svg-input.svg";
# Autorun starts in an empty directory; keep the default fixture self-contained.
if (ARGV.len() <= 2 && !file_exists(svgfile)) {
  mkdir(dirname(svgfile));
  write_file(svgfile, "<svg width=\"200\" height=\"120\" viewBox=\"0 0 200 120\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <linearGradient id=\"bg\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#2c3e50\" />\n      <stop offset=\"100%\" stop-color=\"#3498db\" />\n    </linearGradient>\n  </defs>\n  <rect width=\"200\" height=\"120\" fill=\"url(#bg)\" />\n  <rect x=\"15\" y=\"15\" width=\"50\" height=\"35\" rx=\"5\" ry=\"5\" fill=\"#e74c3c\" />\n  <circle cx=\"100\" cy=\"35\" r=\"20\" fill=\"#f1c40f\" />\n  <path d=\"M 140 20 L 180 35 L 140 50 Z\" fill=\"#2ecc71\" />\n  <path d=\"M 20 80 Q 100 115 180 80\" stroke=\"#ffffff\" stroke-width=\"3\" stroke-linecap=\"round\" fill=\"none\" />\n  <text x=\"35\" y=\"105\" font-family=\"DejaVu Sans\" font-size=\"14\" fill=\"#ffffff\">lmvideo golden</text>\n</svg>\n");
}
mkdir("images");
# Original example artwork is embedded so raw autorun needs no checkout.
if (ARGV.len() <= 2) { write(svgfile, "<svg width=\"200\" height=\"120\" viewBox=\"0 0 200 120\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <linearGradient id=\"bg\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#2c3e50\" />\n      <stop offset=\"100%\" stop-color=\"#3498db\" />\n    </linearGradient>\n  </defs>\n  <rect width=\"200\" height=\"120\" fill=\"url(#bg)\" />\n  <rect x=\"15\" y=\"15\" width=\"50\" height=\"35\" rx=\"5\" ry=\"5\" fill=\"#e74c3c\" />\n  <circle cx=\"100\" cy=\"35\" r=\"20\" fill=\"#f1c40f\" />\n  <path d=\"M 140 20 L 180 35 L 140 50 Z\" fill=\"#2ecc71\" />\n  <path d=\"M 20 80 Q 100 115 180 80\" stroke=\"#ffffff\" stroke-width=\"3\" stroke-linecap=\"round\" fill=\"none\" />\n  <text x=\"35\" y=\"105\" font-family=\"DejaVu Sans\" font-size=\"14\" fill=\"#ffffff\">lmvideo golden</text>\n</svg>\n"); }
program = _lmcode_ cli="lmvideo" install="github:lmctl-ai/lmvideo@latest";
video.size(640, 360);
video.frames(1);
video.output(${png});
video.begin();
video.frame();
  canvas.clear("#ffffff");
  let doc = svg_file(${svgfile});
  canvas.svg(doc, 20.0, 20.0, 600.0, 320.0);
  canvas.rect(0.0, 0.0, 640.0, 6.0, paint().color("#333333"));
  out.print("svg is " + str(doc.width()) + "x" + str(doc.height()));
video.end();
end _lmcode_
mkdir(dirname(dslout));
savedsl(program, dslout);
# No arguments: run the compiled chunk with the released host (lmctl autorun). With arguments: compile only.
if (standalone) {
  r = system(concat(dsl_cli(program), ["--dsl", dslout]), 600000);
  if (r.code != 0) { println(r.stderr + r.stdout); }
  assert(r.code == 0);
}
println(f"wrote {dslout} ({svgfile} -> {png})");
