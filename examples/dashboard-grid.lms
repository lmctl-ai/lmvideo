# Four charts composed in a weighted 2×2 Panel grid.
standalone = ARGV.len() == 0;
dslout = ARGV.len() > 0 ? ARGV[0] : "build/dashboard-grid.dslb";
mp4 = ARGV.len() > 1 ? ARGV[1] : "images/dashboard-grid.mp4";
png = ARGV.len() > 2 ? ARGV[2] : "images/dashboard-grid.png";
mkdir("images");
program = _lmcode_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.25";
video.size(960, 540); video.fps(30); video.frames(1); video.crf(20); video.output(${mp4}); video.begin(); video.frame(); canvas.clear("#f5f7fa");
let dashboard = canvas.panel(18.0, 18.0, 924.0, 504.0).manager("grid").columns(2).row_weight(0, 1.0).row_weight(1, 1.0).column_weight(0, 1.0).column_weight(1, 1.0).padding(10.0, 10.0, 10.0, 10.0).gap(12.0).background("#f5f7fa");
let trend_item = dashboard.add_plot().grid(0, 0, 1, 1).sticky("nsew");
let trend = trend_item.plot().title("Weekly requests").xlabel("week").ylabel("requests (k)").x_range(1.0, 8.0).y_range(0.0, 80.0).background("#ffffff");
let trend_line = trend.series("requests", "line", "#2878b5").width(2.5).marker("circle");
trend_line.add(1.0, 18.0).add(2.0, 24.0).add(3.0, 21.0).add(4.0, 36.0).add(5.0, 42.0).add(6.0, 48.0).add(7.0, 58.0).add(8.0, 69.0);
let sales_item = dashboard.add_plot().grid(0, 1, 1, 1).sticky("nsew");
let sales = sales_item.plot().title("Revenue mix").xlabel("quarter").ylabel("revenue ($M)").x_range(0.5, 4.5).y_range(0.0, 90.0).background("#ffffff");
let sales_bars = sales.series("sales", "bar", "#7256a8");
sales_bars.add(1.0, 42.0).add(2.0, 55.0).add(3.0, 67.0).add(4.0, 78.0);
let accuracy_item = dashboard.add_plot().grid(1, 0, 1, 1).sticky("nsew");
let accuracy = accuracy_item.plot().title("Calibration error").xlabel("reference").ylabel("measured").x_range(0.0, 6.0).y_range(0.0, 70.0).background("#ffffff");
let error = accuracy.series("readings", "errorbar", "#168c83");
error.add_error(1.0, 12.0, 10.0, 14.0).add_error(2.0, 21.0, 18.0, 23.0).add_error(3.0, 30.0, 28.0, 33.0).add_error(4.0, 39.0, 36.0, 42.0).add_error(5.0, 49.0, 47.0, 53.0);
let forecast_item = dashboard.add_plot().grid(1, 1, 1, 1).sticky("nsew");
let forecast = forecast_item.plot().title("Adoption projection").xlabel("month").ylabel("users (k)").x_range(0.0, 12.0).y_range(0.0, 100.0).background("#ffffff");
let forecast_area = forecast.series("projected", "area", "#df5b36").width(2.0);
forecast_area.add(0.0, 3.0).add(2.0, 8.0).add(4.0, 20.0).add(6.0, 50.0).add(8.0, 78.0).add(10.0, 92.0).add(12.0, 98.0);
dashboard.draw(); video.save_frame(${png}); video.end();
end _lmcode_
mkdir(dirname(dslout)); savedsl(program, dslout);
if (standalone) {
  r = system(concat(dsl_cli(program), ["--dsl", dslout]), 600000); if (r.code != 0) { println(r.stderr + r.stdout); } assert(r.code == 0);
}
println(f"wrote {dslout} ({mp4}, {png})");
