# Same 80-observation heteroscedastic regression sample, OLS fit and metrics as lmplot.
let seed=31337;let n=80;let xs=[];let ys=[];
for(i in range(0,n)){seed=(seed*16807)%2147483647;let x=10.0*num(seed)/2147483647.0;let g=-6.0;for(k in range(0,12)){seed=(seed*16807)%2147483647;g=g+num(seed)/2147483647.0;}xs=push(xs,x);ys=push(ys,2.0+1.5*x+(0.6+0.08*x)*g);}
let sx=0.0;let sy=0.0;let sxx=0.0;let sxy=0.0;for(i in range(0,n)){sx=sx+xs[i];sy=sy+ys[i];sxx=sxx+xs[i]*xs[i];sxy=sxy+xs[i]*ys[i];}
let slope=(num(n)*sxy-sx*sy)/(num(n)*sxx-sx*sx);let intercept=(sy-slope*sx)/num(n);let mean=sy/num(n);let rss=0.0;let tss=0.0;let residuals=[];
for(i in range(0,n)){let fit=intercept+slope*xs[i];let r=ys[i]-fit;residuals=push(residuals,fit);residuals=push(residuals,r);rss=rss+r*r;tss=tss+(ys[i]-mean)*(ys[i]-mean);}
let r2=1.0-rss/tss;let rmse=sqrt(rss/num(n));
mkdir("images");standalone=ARGV.len()==0;dslout=ARGV.len()>0?ARGV[0]:"build/residual-scatter.dslb";let mp4=ARGV.len()>1?ARGV[1]:"images/residual-scatter.mp4";let png=ARGV.len()>2?ARGV[2]:"images/residual-scatter.png";
program = _dsl_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.26";
video.size(960,540);video.frames(1);video.output(${mp4});video.begin();video.frame();canvas.clear("#f5f7fa");let p=canvas.plot(30.0,20.0,900.0,500.0).title(${"Residuals vs fitted · R² "+str(r2)+" · RMSE "+str(rmse)}).xlabel("fitted y-hat").ylabel("residual").y_range(-2.5,2.5).background("#ffffff");p.hline(0.0,"#334155",1.8);let dots=p.series("residual","scatter","#0f766e").marker("circle").width(3.0);let local_seed=31337;for(i in range(0,80)){local_seed=(local_seed*16807)%2147483647;let x=10.0*float(local_seed)/2147483647.0;let g=-6.0;for(k in range(0,12)){local_seed=(local_seed*16807)%2147483647;g=g+float(local_seed)/2147483647.0;}let y=2.0+1.5*x+(0.6+0.08*x)*g;let fitted=${intercept}+${slope}*x;dots.add(fitted,y-fitted);}p.draw();video.save_frame(${png});video.end();
end _dsl_
mkdir(dirname(dslout));savedsl(program,dslout);if(standalone){r=system(concat(dsl_cli(program),["--dsl",dslout]),600000);if(r.code!=0){println(r.stderr+r.stdout);}assert(r.code==0);}
