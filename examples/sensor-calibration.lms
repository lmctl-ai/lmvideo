# Calibration observations with explicit lower/upper error-bar coordinates.
standalone = ARGV.len() == 0;
dslout = ARGV.len() > 0 ? ARGV[0] : "build/sensor-calibration.dslb";
mp4 = ARGV.len() > 1 ? ARGV[1] : "images/sensor-calibration.mp4";
png = ARGV.len() > 2 ? ARGV[2] : "images/sensor-calibration.png";
mkdir("images");
program = _lmcode_ cli="lmvideo" install="github:lmctl-ai/lmvideo@v0.1.23";
video.size(960, 540); video.fps(30); video.frames(240); video.crf(20); video.output(${mp4}); video.begin();
let figure = canvas.panel(24.0, 20.0, 912.0, 500.0).manager("border").padding(12.0, 12.0, 12.0, 12.0).gap(8.0).background("#f5f7fa").edge("#cbd5e1", 1.0);
let header = figure.add_text("Sensor calibration · observed value and uncertainty").border("north").preferred_size(880.0, 36.0).text().size(18.0).bold(true);
let chart_item = figure.add_plot().border("center");
let footer = figure.add_text("Dashed crosshairs mark the reference point: 40 °C.").border("south").preferred_size(880.0, 24.0).text().size(12.0).color("#667085");
let plot = chart_item.plot().title("Measured sensor response").xlabel("reference temperature (°C)").ylabel("sensor reading (°C)").x_range(0.0, 80.0).y_range(0.0, 90.0).background("#ffffff");
let readings = plot.series("measured", "errorbar", "#168c83").width(2.0).marker("circle");
plot.hline(40.0, "#667085", 1.2).vline(40.0, "#df5b36", 1.2);
fn fill_readings(s: Series, progress: float) -> void {
  s.clear();
  if (progress >= 0.15) { s.add_error(10.0, 12.0, 10.5, 13.5); }
  if (progress >= 0.28) { s.add_error(20.0, 22.0, 20.8, 23.2); }
  if (progress >= 0.41) { s.add_error(30.0, 31.0, 29.8, 32.2); }
  if (progress >= 0.54) { s.add_error(40.0, 41.0, 40.0, 42.0); }
  if (progress >= 0.67) { s.add_error(50.0, 50.0, 48.7, 51.3); }
  if (progress >= 0.80) { s.add_error(60.0, 60.5, 59.0, 62.0); }
  if (progress >= 0.93) { s.add_error(70.0, 69.0, 67.0, 71.0); }
}
for (frame in range(0, video.count())) {
  video.frame(); canvas.clear("#f5f7fa"); fill_readings(readings, video.t()); figure.draw();
  if (video.index() == video.count() - 1) { video.save_frame(${png}); }
}
video.end();
end _lmcode_
mkdir(dirname(dslout)); savedsl(program, dslout);
if (standalone) {
  r = system(concat(dsl_cli(program), ["--lmcode", dslout]), 600000); if (r.code != 0) { println(r.stderr + r.stdout); } assert(r.code == 0);
  if (which("ffmpeg") != null) {
    g = system ffmpeg -y -loglevel error -i images/sensor-calibration.mp4 -vf "fps=12,scale=480:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=64[p];[b][p]paletteuse=dither=none" -loop 0 images/sensor-calibration.gif;
    assert(g.code == 0);
  }
}
println(f"wrote {dslout} ({mp4}, {png})");
